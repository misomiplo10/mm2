---
import { company } from "../data/company";
import { href, langFromUrl, ui } from "../i18n";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <h4>{company.legalName}</h4>
        <p>
          {company.address.slice(0, 2).map((l) => <>{l}<br /></>)}
          CVR {company.cvr}
        </p>
      </div>
      <div>
        <h4>{t.navigation}</h4>
        <ul>
          <li><a href={href(lang, "shop")}>{t.allProducts}</a></li>
          <li><a href={href(lang, "faq")}>{t.faq}</a></li>
        </ul>
      </div>
      <div>
        <h4>{t.buyDelivery}</h4>
        <ul>
          <li><a href={href(lang, "terms")}>{t.terms}</a></li>
          <li><a href={href(lang, "withdraw")}>{t.withdraw}</a></li>
          <li><a href={href(lang, "privacy")}>{t.privacy}</a></li>
        </ul>
      </div>
      <div>
        <h4>{t.contact}</h4>
        <ul>
          <li><a href={`mailto:${company.serviceEmail}`}>{company.serviceEmail}</a></li>
          <li><a href={company.phoneHref}>{company.phone}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{t.supervision}</span>
      <span>{t.legalLine}</span>
    </div>
  </div>
</footer>
