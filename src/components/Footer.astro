---
import { company } from "../data/company";
import { href, langFromUrl, ui } from "../i18n";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <img src="/img/logo-orange.png" alt="Mister Mellow" />
        <p>{t.footerTagline}</p>
      </div>
      <div>
        <h4>{t.navigation}</h4>
        <ul>
          <li><a href={href(lang, "shop")}>Shop</a></li>
          <li><a href={href(lang, "lab")}>{t.labReports}</a></li>
          <li><a href={href(lang, "about")}>{t.about}</a></li>
          <li><a href={href(lang, "faq")}>{t.faq}</a></li>
          <li><a href={href(lang, "find")}>{t.findUs}</a></li>
        </ul>
      </div>
      <div>
        <h4>{t.retailers}</h4>
        <ul>
          <li><a href={href(lang, "retail")}>{t.becomeRetailer}</a></li>
          <li><a href={`${href(lang, "retail")}#vilkaar`}>{t.termsDelivery}</a></li>
          <li><a href={company.catalog} target="_blank" rel="noopener">{t.catalog}</a></li>
        </ul>
      </div>
      <div>
        <h4>{t.contact}</h4>
        <ul>
          <li><a href={company.phoneHref}>{company.phone}</a></li>
          <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
          <li><a href={company.instagramUrl} target="_blank" rel="noopener">{company.instagram}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-disclaimer">
      <div>
        <h4>{t.ourPolicy}</h4>
        <p>{t.ourPolicyText}</p>
      </div>
      <div>
        <h4>{t.disclaimer}</h4>
        <p>{t.disclaimerText}</p>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {company.legalName} · CVR {company.cvr} · <a href={href(lang, "privacy")}>{t.privacy}</a></span>
      <span>{t.adultsOnly}</span>
    </div>
  </div>
</footer>
