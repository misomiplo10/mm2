---
import { langFromUrl } from "../i18n";

interface Props {
  /** Set when the photo is at the top of the page, so it loads right away */
  eager?: boolean;
}

const { eager = false } = Astro.props;

const alt =
  langFromUrl(Astro.url) === "en"
    ? "Open Sunday Cruise pouch with Cali flower spilling out"
    : "Åben Sunday Cruise-pose med Cali-flower, der vælter ud";
---

<figure class="story-photo">
  <img
    src="/img/story-wall-1800.webp"
    srcset="/img/story-wall-1100.webp 1100w, /img/story-wall-1800.webp 1800w, /img/story-wall-2800.webp 2800w"
    sizes="(max-width: 980px) 180vw, 100vw"
    width="2800"
    height="1170"
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
    decoding="async"
  />
</figure>
