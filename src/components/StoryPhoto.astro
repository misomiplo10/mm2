---
import { langFromUrl } from "../i18n";

const alt =
  langFromUrl(Astro.url) === "en"
    ? "Open Sunday Cruise pouch with Cali flower spilling out"
    : "Åben Sunday Cruise-pose med Cali-flower, der vælter ud";
---

<figure class="story-photo">
  <img
    src="/img/story-pouch-1600.webp"
    srcset="/img/story-pouch-1000.webp 1000w, /img/story-pouch-1600.webp 1600w, /img/story-pouch-2400.webp 2400w"
    sizes="(max-width: 980px) 100vw, 50vw"
    width="2400"
    height="1288"
    alt={alt}
    loading="lazy"
    decoding="async"
  />
</figure>
