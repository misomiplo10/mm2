---
import ProductVisual from "./ProductVisual.astro";
import { cartData, fromPrice, hasSizeChoice, isBuyable, kr, metaLine, productUrl, shopVariants, type Product } from "../data/products";
import { langFromUrl, ui } from "../i18n";

interface Props {
  product: Product;
}

const { product: p } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = ui[lang];
const buyable = isBuyable(p);
const sizes = hasSizeChoice(p);
const url = productUrl(p, lang);
---

<article class="pcard" data-cat={p.category}>
  <a class={`pcard-media bg-${p.tint}`} href={url} aria-label={p.name}>
    {p.onRequest && <span class="pcard-flag">{t.onRequest}</span>}
    {!p.onRequest && !buyable && <span class="pcard-flag">{t.comingSoon}</span>}
    <ProductVisual visual={p.visual} />
  </a>
  <div class="pcard-body">
    <span class="pcard-brand">Mister Mellow</span>
    <h3><a href={url}>{p.name}</a></h3>
    <span class="pcard-meta">{metaLine(p, lang)}</span>
    <p>{p.description[lang]}</p>
    <div class="pcard-price">
      {buyable ? (
        <span>{sizes && <small>{t.from} </small>}{kr(fromPrice(p), lang)}</span>
      ) : (
        <span class="muted">{p.onRequest ? t.priceOnRequest : t.priceSoon}</span>
      )}
      {sizes ? (
        <span class="chips">{shopVariants(p).map((v) => <span class="chip">{v.size}</span>)}</span>
      ) : (
        p.size && <span class="chip">{p.size}</span>
      )}
    </div>
    {buyable && sizes ? (
      <a class="btn btn-navy btn-block" href={url}>{t.chooseSize}</a>
    ) : buyable ? (
      <button class="btn btn-navy btn-block" data-add={cartData(p)}>{t.addToCart}</button>
    ) : (
      <a class="btn btn-ghost btn-block" href={url}>{t.viewProduct}</a>
    )}
  </div>
</article>
