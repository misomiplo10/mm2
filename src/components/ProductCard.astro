---
import { fromPrice, hasSizeChoice, kr, productUrl, sizeRange, type Product } from "../data/products";
import { langFromUrl, ui } from "../i18n";

/** Name, type, weight and price only: no picture, description or colour (BEK 570/2021 § 4, stk. 3 og 6). */
interface Props {
  product: Product;
}

const { product: p } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = ui[lang];
const url = productUrl(p, lang);
const type = { flower: t.typeFlower, preroll: t.typePreroll, hash: t.typeHash, accessory: "" }[p.category];
---

<article class="pcard pcard-text" data-cat={p.category}>
  <div class="pcard-body">
    <h3><a href={url}>{p.name}</a></h3>
    <span class="pcard-meta">{type} · {sizeRange(p)}</span>
    <div class="pcard-price">
      <span>{hasSizeChoice(p) && <>{t.from} </>}{kr(fromPrice(p), lang)}</span>
    </div>
    <a class="btn btn-navy btn-block" href={url}>{hasSizeChoice(p) ? t.chooseSize : t.viewProduct}</a>
  </div>
</article>
