---
import BuyRow from "./BuyRow.astro";
import { gramRange, productHref, sizeRange, type ShopProduct } from "../data/shop";

interface Props {
  products: ShopProduct[];
}
const { products } = Astro.props;
---

<ul class="plist">
  {products.map((p) => (
    <li class="prow" data-name={p.name.toLowerCase()}>
      <div class="prow-info">
        <a href={productHref(p)}>{p.name}</a>
        <span class="muted">{p.category.label} · {sizeRange(p)} · {gramRange(p)}</span>
      </div>
      <BuyRow product={p} />
    </li>
  ))}
</ul>
<p id="cart-status" class="muted" role="status" aria-live="polite"></p>

<style>
  .plist { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .prow { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px 24px; padding: 14px 0; border-bottom: 1px solid var(--line); max-width: none; }
  .prow-info { display: grid; gap: 2px; min-width: 200px; }
  .prow-info .muted { font-size: 14px; }
</style>
