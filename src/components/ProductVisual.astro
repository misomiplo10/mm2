---
import type { Visual } from "../data/products";

interface Props {
  visual: Visual;
}

const { visual: v } = Astro.props;
---

{v.kind === "pouch" && (
  <div class={`pouch pouch-${v.color}`}>
    <img src={`/img/logo-${v.logo}.png`} alt="" />
    <span class="label">{v.label}</span>
  </div>
)}
{v.kind === "tubes" && (
  <div class="tube-duo">
    {[0, 1].map(() => (
      <div class={`tube tube-${v.color}`}>
        <img src="/img/logo-green.png" alt="" />
        {v.label && <span class="label">{v.label}</span>}
      </div>
    ))}
  </div>
)}
{v.kind === "lighter" && (
  <div class="lighter"><img src="/img/logo-green.png" alt="" /></div>
)}
{v.kind === "photo" && <img class="photo" src={v.src} alt={v.alt} loading="lazy" />}
{v.kind === "packshot" && <img class="packshot" src={v.src} alt={v.alt} loading="lazy" />}
{v.kind === "cover" && <img class="cover" src={v.src} alt={v.alt} loading="lazy" />}
