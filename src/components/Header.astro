---
import { categories } from "../data/products";
import { company } from "../data/company";
import { categoryHref, href, langFromUrl, langs, translatePath, ui, type Route } from "../i18n";

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const links: { route: Route; label: string }[] = [
  { route: "faq", label: t.faq },
  { route: "terms", label: t.terms },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const current = (route: Route) => (path === (href(lang, route).replace(/\/$/, "") || "/") ? "page" : undefined);
const shopPath = href(lang, "shop");
---

<header class="site-header">
  <nav class="nav wrap" aria-label={t.mainMenu}>
    <a class="brand brand-logo" href={href(lang, "home")} aria-label={t.skipHome}><img src="/img/logo-stacked-cream.webp" alt={company.name} width="83" height="48" /></a>
    <ul class="nav-links">
      <li class="has-menu">
        <a href={shopPath} aria-current={path.startsWith(shopPath) ? "page" : undefined}>Shop <span class="caret" aria-hidden="true">▾</span></a>
        <ul class="submenu">
          {categories.map((c) => <li><a href={categoryHref(lang, c.id)}>{c.label[lang]}</a></li>)}
          <li><a href={shopPath}>{t.seeAll}</a></li>
        </ul>
      </li>
      {links.map((l) => <li><a href={href(lang, l.route)} aria-current={current(l.route)}>{l.label}</a></li>)}
    </ul>
    <div class="nav-actions">
      <div class="lang-switch" role="group" aria-label={t.language}>
        {langs.map((l) => (
          <a href={translatePath(Astro.url.pathname, l)} hreflang={l} lang={l} aria-current={l === lang ? "true" : undefined}>{l.toUpperCase()}</a>
        ))}
      </div>
      <button class="cart-btn" data-cart-open aria-label={t.openCart}>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 7h12l-1 13H7L6 7z"></path><path d="M9 7a3 3 0 0 1 6 0"></path>
        </svg>
        <span class="cart-count" data-cart-count hidden>0</span>
      </button>
      <button class="nav-toggle" aria-label={t.menu} aria-expanded="false"><span></span><span></span><span></span></button>
    </div>
  </nav>
</header>
