---
import { href, langFromUrl, ui } from "../i18n";
const lang = langFromUrl(Astro.url);
const t = ui[lang];
---

<div class="cart-backdrop" id="cart-backdrop" hidden></div>
<aside class="cart-drawer" id="cart-drawer" aria-hidden="true" aria-label={t.cart}>
  <div class="cart-head">
    <h2>{t.yourCart}</h2>
    <button class="cart-close" data-cart-close aria-label={t.closeCart}>×</button>
  </div>
  <div class="cart-empty" data-cart-empty>
    <img src="/img/logo-navy.png" alt="" />
    <p>{t.cartEmpty}</p>
    <a class="btn btn-navy" href={href(lang, "shop")}>{t.toShop}</a>
  </div>
  <div class="cart-lines" data-cart-lines></div>
  <div class="cart-foot" data-cart-filled hidden>
    <div class="ship-meter" data-ship-meter>
      <p data-ship-text></p>
      <div class="ship-bar" aria-hidden="true"><span data-ship-fill></span></div>
    </div>
    <div class="cart-total"><span>{t.subtotal}</span><strong data-cart-subtotal>{lang === "en" ? "DKK 0" : "0 kr"}</strong></div>
    <p class="cart-note">{t.cartNote}</p>
    <a class="btn btn-orange btn-block" href={href(lang, "cart")}>{t.checkout}</a>
    <button class="cart-continue" data-cart-close>{t.keepShopping}</button>
  </div>
</aside>
