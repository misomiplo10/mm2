---
import BaseLayout from "../layouts/BaseLayout.astro";
import { kr, products } from "../data/products";
import { company } from "../data/company";
import { langFromUrl } from "../i18n";

const lang = langFromUrl(Astro.url);
const VAT = 1.25;
const byName = (name: string) => products.find((p) => p.name === name)!;
const money = (n: number) => kr(n, lang);

const copy = {
  da: {
    title: "For forhandlere – Mister Mellow",
    description: "Bliv forhandler af Mister Mellow. Opstartspakke inkl. display, høj avance, levering på 1–2 dage.",
    eyebrow: "For forhandlere",
    h1: ["Et display, der ", "sælger for dig."],
    lead: "Høj avance, hurtig omsætning og personlig levering. Sæt Mister Mellow ved kassen og lad sortimentet gøre arbejdet.",
    become: "Bliv forhandler",
    getCatalog: "Hent katalog 2026 (PDF)",
    subnavLabel: "Forhandlersektioner",
    subnav: ["Opstartspakke", "Priser", "Avance", "Vilkår", "Kontakt"],
    startEyebrow: "Kom i gang",
    startH: ["Opstartspakke ", "til din butik."],
    exVat: "EKSKL. MOMS",
    inclVatPrice: "5.800 kr inkl. moms",
    starterTicks: ["Sammensæt selv din pakke frit fra hele kollektionen.", "Mister Mellow-display medfølger.", "Vejledende udsalgspriser på alle produkter."],
    orderStarter: "Bestil opstartspakke",
    displayAlt: "Mister Mellow display fyldt med pre-rolls og poser",
    pricesEyebrow: "Produkter & priser",
    pricesH: ["Kollektionen ", "& priser."],
