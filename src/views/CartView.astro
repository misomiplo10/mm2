---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { countryList, href, langFromUrl, ui } from "../i18n";
import { company } from "../data/company";


const lang = langFromUrl(Astro.url);
const t = ui[lang];
const countries = countryList(company.shippingCountries, lang);
const copy = {
  da: {
    title: "Kurv & kasse",
    description: "Din kurv hos Mister Mellow.",
    delivery: "Levering",
    name: "Fulde navn",
    email: "E-mail",
    phone: "Telefon",
    address: "Adresse",
    zip: "Postnr.",
    city: "By",
    country: "Land",
    age: "Før købet gennemføres, kontrollerer vi din alder med MitID. Vi sælger ikke til personer under 18 år.",
    keyInfo: "Betaling med VISA eller Mastercard. Beløbet trækkes, når ordren sendes. Du har 14 dages fortrydelsesret på uåbnede varer; fortrydelsesretten bortfalder for en vare, hvis forseglingen er brudt efter leveringen.",
    onlyDk: "Vi leverer kun til adresser i Danmark.",
    termsBefore: "Jeg har læst og accepterer ",
    termsAfter: ".",
    error: "Udfyld alle felter og accepter handelsbetingelserne.",
    thanks: "Webshoppen er ikke åben endnu.",
    notice: "Betaling og MitID-alderskontrol er ikke sat op, så der er ikke afgivet nogen ordre, og du er ikke blevet opkrævet.",
    summary: "Oversigt",
    shipping: "Fragt",
    shippingLater: "Beregnes ved betaling",
    total: "I alt",
    vat: "Alle priser er inkl. 25 % moms.",
    pay: "Ordre med betalingsforpligtelse",
    zero: "0 kr",
  },
  en: {
    title: "Cart & checkout",
    description: "Your cart at Mister Mellow.",
    delivery: "Delivery",
    name: "Full name",
    email: "Email",
    phone: "Phone",
    address: "Address",
    zip: "Postcode",
    city: "City",
    country: "Country",
    age: "Before the purchase is completed, we check your age with MitID. We do not sell to anyone under 18.",
    keyInfo: "Payment by VISA or Mastercard. You are charged when the order ships. You have a 14-day right to cancel on unopened items; it lapses for an item if its seal is broken after delivery.",
    onlyDk: "We only deliver to addresses in Denmark.",
    termsBefore: "I have read and accept the ",
    termsAfter: ".",
    error: "Please fill in all fields and accept the terms and conditions.",
    thanks: "The web shop is not open yet.",
    notice: "Payment and MitID age verification are not set up, so no order has been placed and you have not been charged.",
    summary: "Summary",
    shipping: "Shipping",
    shippingLater: "Calculated at payment",
    total: "Total",
    vat: "All prices include 25% Danish VAT.",
    pay: "Order with obligation to pay",
    zero: "DKK 0",
  },
}[lang];
---

<BaseLayout title={`${copy.title} – Mister Mellow ApS`} description={copy.description}>
  <section class="block page-top">
    <div class="wrap">
      <SectionTitle title={copy.title} />

      <div class="cart-empty page" data-cart-empty>
        <p>{t.cartEmpty}</p>
        <a class="btn btn-navy" href={href(lang, "shop")}>{t.toShop}</a>
      </div>

      <div class="checkout" data-cart-filled hidden>
        <div class="checkout-main">
          <div class="panel">
            <h2 class="panel-h">{t.yourCart}</h2>
            <div class="cart-lines" id="checkout-lines"></div>
          </div>

          <form class="panel checkout-form" id="checkout-form" novalidate>
            <h2 class="panel-h">{copy.delivery}</h2>
            <div class="fields">
              <label class="field span-2">{copy.name}<input name="name" autocomplete="name" required /></label>
              <label class="field">{copy.email}<input name="email" type="email" autocomplete="email" required /></label>
              <label class="field">{copy.phone}<input name="phone" type="tel" autocomplete="tel" required /></label>
              <label class="field span-2">{copy.address}<input name="address" autocomplete="street-address" required /></label>
              <label class="field">{copy.zip}<input name="zip" autocomplete="postal-code" inputmode="numeric" pattern="[0-9]{4}" required /></label>
              <label class="field">{copy.city}<input name="city" autocomplete="address-level2" required /></label>
              <p class="field span-2">{copy.country}: {countries[0].name}. {copy.onlyDk}</p>
            </div>
            <p class="page-note">{copy.age}</p>
            <p class="page-note">{copy.keyInfo}</p>
            <label class="check"><input type="checkbox" name="terms" required /> <span>{copy.termsBefore}<a href={href(lang, "terms")} target="_blank" rel="noopener">{t.terms.toLowerCase()}</a>{copy.termsAfter}</span></label>
            <p class="form-error" id="form-error" hidden>{copy.error}</p>
            <div class="notice" id="checkout-notice" hidden>
              <strong>{copy.thanks}</strong>
              {copy.notice}
            </div>
          </form>
        </div>

        <aside class="panel summary">
          <h2 class="panel-h">{copy.summary}</h2>
          <div class="sum-row"><span>{t.subtotal}</span><span data-cart-subtotal>{copy.zero}</span></div>
          <div class="sum-row"><span>{copy.shipping}</span><span>{copy.shippingLater}</span></div>
          <div class="sum-row total"><span>{copy.total}</span><strong data-cart-subtotal>{copy.zero}</strong></div>
          <p class="cart-note">{copy.vat}</p>
          <button class="btn btn-orange btn-block btn-lg" type="submit" form="checkout-form">{copy.pay}</button>
          <a class="cart-continue" href={href(lang, "shop")}>{t.keepShopping}</a>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { bindLines, getItems, lineHtml, onChange } from "../scripts/cart";

  const lines = document.getElementById("checkout-lines")!;
  const render = () => (lines.innerHTML = getItems().map(lineHtml).join(""));
  bindLines(lines);
  onChange(render);
  render();

  // Payment isn't connected yet: validate the details, then say so plainly instead of pretending to order.
  const form = document.getElementById("checkout-form") as HTMLFormElement;
  const error = document.getElementById("form-error")!;
  const notice = document.getElementById("checkout-notice")!;
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const ok = form.checkValidity();
    error.hidden = ok;
    notice.hidden = !ok;
    form.classList.toggle("tried", !ok);
    (ok ? notice : error).scrollIntoView({ behavior: "smooth", block: "center" });
  });
</script>
