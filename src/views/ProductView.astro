---
import BaseLayout from "../layouts/BaseLayout.astro";
import { cartData, categoryLabel, categoryUrl, hasSizeChoice, kr, shopVariants, type Product } from "../data/products";
import { company } from "../data/company";
import { href, langFromUrl, ui } from "../i18n";

/**
 * Text only: name, type, weight, price and what the packaging says. No pictures, videos,
 * descriptions or claims (BEK 570/2021 § 4, stk. 3, 4 og 6).
 */
interface Props {
  product: Product;
}

const { product: p } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = ui[lang];
const copy = {
  da: {
    crumbs: "Brødkrumme",
    inclVat: "inkl. moms",
    size: "Vægt",
    qty: "Antal",
    fewer: "Færre",
    more: "Flere",
    age: "Aldersgrænse 18 år. Din alder kontrolleres med MitID, før et køb kan gennemføres.",
    details: "Oplysninger",
    type: "Produkttype",
    maker: "Fabrikant",
    warning: "Advarsel",
    warningText: "Rygning af dette produkt er sundhedsskadeligt",
    ageLimit: "Aldersgrænse",
    ageLimitText: "18 år",
    coa: "Analysecertifikat",
    coaText: "Sendes på anmodning for den konkrete batch",
    prices: "Vægt og priser",
    price: "Pris",
    perKg: "Kilopris",
  },
  en: {
    crumbs: "Breadcrumb",
    inclVat: "incl. VAT",
    size: "Weight",
    qty: "Quantity",
    fewer: "Fewer",
    more: "More",
    age: "Age limit 18. Your age is checked with MitID before a purchase can be completed.",
    details: "Details",
    type: "Product type",
    maker: "Manufacturer",
    warning: "Warning",
    warningText: "Smoking this product damages your health",
    ageLimit: "Age limit",
    ageLimitText: "18",
    coa: "Certificate of analysis",
    coaText: "Sent on request for the specific batch",
    prices: "Weights and prices",
    price: "Price",
    perKg: "Price per kg",
  },
}[lang];
const variants = shopVariants(p);
const sizes = hasSizeChoice(p);
const type = { flower: t.typeFlower, preroll: t.typePreroll, hash: t.typeHash, accessory: "" }[p.category];
const maker = `${company.legalName}, ${company.address.slice(0, 2).join(", ")}, ${company.serviceEmail}`;
/** Unit price per kg, required for prepacked goods of 50 g or more (BEK 1696/2017 §§ 3 og 8). */
const perKg = (size: string, price: number) => (parseFloat(size) >= 50 ? `${kr(Math.round((price / parseFloat(size)) * 1000), lang)}/kg` : "–");
---

<BaseLayout title={`${p.name} – Mister Mellow`} description={`${p.name}. ${type}. ${copy.age}`}>
  <section class="block page-top">
    <div class="wrap">
      <div class="notice-box">{copy.age}</div>
      <nav class="crumbs" aria-label={copy.crumbs}>
        <a href={href(lang, "shop")}>{t.allProducts}</a><span>/</span><a href={categoryUrl(p.category, lang)}>{categoryLabel(p.category, lang)}</a><span>/</span><span>{p.name}</span>
      </nav>
      <div class="pdp pdp-text">
        <div class="pdp-info">
          <h1 class="pdp-title">{p.name}</h1>
          <span class="pcard-meta">{type}</span>
          <div class="buy-box">
            <div class="pdp-price"><span data-price>{kr(variants[0].retail, lang)}</span> <small>{copy.inclVat}</small></div>
            {sizes ? (
              <div class="pdp-size">
                <span id="size-label">{copy.size}</span>
                <div class="size-picker" role="radiogroup" aria-labelledby="size-label">
                  {variants.map((v, i) => (
                    <button type="button" class="size-opt" role="radio" aria-checked={i === 0 ? "true" : "false"} data-variant={cartData(p, v)} data-price-label={kr(v.retail, lang)}>
                      {v.size}
                    </button>
                  ))}
                </div>
              </div>
            ) : (
              p.size && <div class="pdp-size"><span>{copy.size}</span><span class="chip">{p.size}</span></div>
            )}
            <div class="buy-row">
              <label class="qty">
                <span class="sr-only">{copy.qty}</span>
                <button type="button" data-step="-1" aria-label={copy.fewer}>−</button>
                <input type="number" min="1" max="20" value="1" inputmode="numeric" data-qty-input />
                <button type="button" data-step="1" aria-label={copy.more}>+</button>
              </label>
              <button class="btn btn-navy btn-lg" data-add={cartData(p, variants[0])}>{t.addToCart}</button>
            </div>
          </div>
        </div>
        <div class="pdp-facts">
          <h2>{copy.details}</h2>
          <dl class="facts">
            <dt>{copy.type}</dt><dd>{type}</dd>
            <dt>{copy.maker}</dt><dd>{maker}</dd>
            <dt>{copy.warning}</dt><dd>{copy.warningText}</dd>
            <dt>{copy.ageLimit}</dt><dd>{copy.ageLimitText}</dd>
            <dt>{copy.coa}</dt><dd>{copy.coaText}</dd>
          </dl>
          <h2>{copy.prices}</h2>
          <table class="price-table">
            <thead><tr><th>{copy.size}</th><th>{copy.price}</th><th>{copy.perKg}</th></tr></thead>
            <tbody>{variants.map((v) => <tr><td>{v.size}</td><td>{kr(v.retail, lang)}</td><td>{perKg(v.size, v.retail)}</td></tr>)}</tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Size picker: the chosen size drives the shown price and what "Læg i kurv" adds
  document.querySelectorAll<HTMLElement>(".size-picker").forEach((picker) => {
    const box = picker.closest(".buy-box")!;
    const price = box.querySelector<HTMLElement>("[data-price]")!;
    const add = box.querySelector<HTMLElement>("[data-add]")!;
    const opts = [...picker.querySelectorAll<HTMLButtonElement>(".size-opt")];
    const select = (opt: HTMLButtonElement) => {
      opts.forEach((o) => o.setAttribute("aria-checked", String(o === opt)));
      price.textContent = opt.dataset.priceLabel!;
      add.dataset.add = opt.dataset.variant!;
    };
    opts.forEach((opt, i) => {
      opt.addEventListener("click", () => select(opt));
      opt.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        const next = opts[(i + step + opts.length) % opts.length];
        select(next);
        next.focus();
      });
    });
  });

  // Quantity stepper next to "Læg i kurv"
  document.querySelectorAll<HTMLElement>(".qty").forEach((q) => {
    const input = q.querySelector<HTMLInputElement>("input")!;
    q.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((b) =>
      b.addEventListener("click", () => {
        input.value = String(Math.min(20, Math.max(1, (Number(input.value) || 1) + Number(b.dataset.step))));
      }),
    );
  });
</script>
