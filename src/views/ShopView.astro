---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { categories, products } from "../data/products";
import { langFromUrl, ui } from "../i18n";

const lang = langFromUrl(Astro.url);
const copy = {
  da: {
    description: "Blomster, hash og forrullede produkter med vægt og pris. Salg kun til personer over 18 år.",
    lead: "Priser i danske kroner inkl. 25 % moms. Fragt vises i kurven, før du betaler.",
    note: "Aldersgrænse 18 år. Vi sælger ikke til personer under 18 år. Din alder kontrolleres med MitID, før et køb kan gennemføres.",
    all: "Alle",
    filter: "Filtrér produkter",
    products: "produkter",
  },
  en: {
    description: "Flower, hash and pre-rolled products with weight and price. Sold only to people aged 18 or over.",
    lead: "Prices in Danish kroner including 25% VAT. Shipping is shown in the cart before you pay.",
    note: "Age limit 18. We do not sell to anyone under 18. Your age is checked with MitID before a purchase can be completed.",
    all: "All",
    filter: "Filter products",
    products: "products",
  },
}[lang];
const filters = [{ id: "all", label: copy.all }, ...categories.map((c) => ({ id: c.id, label: c.label[lang] }))];
---

<BaseLayout title={`${ui[lang].allProducts} – Mister Mellow`} description={copy.description}>
  <section class="block page-top">
    <div class="wrap">
      <div class="notice-box">{copy.note}</div>
      <SectionTitle title={ui[lang].allProducts} />
      <p class="page-lead">{copy.lead}</p>
      <div class="filters" role="group" aria-label={copy.filter}>
        {filters.map((f, i) => (
          <button class:list={["filter", { active: i === 0 }]} data-filter={f.id}>{f.label}</button>
        ))}
      </div>
      <p class="result-count" aria-live="polite"><span id="count">{products.length}</span> {copy.products}</p>
      <div class="product-grid">
        {products.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>
</BaseLayout>
