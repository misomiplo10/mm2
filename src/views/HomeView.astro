---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { categories } from "../data/products";
import { company } from "../data/company";
import { categoryHref, href, langFromUrl, ui } from "../i18n";

/** The front page may only show categories, not products (BEK 570/2021 § 4, stk. 5). */
const lang = langFromUrl(Astro.url);
const t = ui[lang];
const copy = {
  da: {
    title: "Mister Mellow ApS",
    description: `Mister Mellow ApS, CVR ${company.cvr}. Urtebaserede rygeprodukter. Salg kun til personer over 18 år.`,
    sub: "Vi sælger urtebaserede rygeprodukter. Vi leverer kun til adresser i Danmark.",
    categories: "Kategorier",
    age: "Aldersgrænse 18 år",
    ageText: "Vi sælger ikke til personer under 18 år. Din alder kontrolleres med MitID, før et køb kan gennemføres.",
    info: [
      ["Levering", `Kun i Danmark. Normalt ${company.deliveryDays} hverdage. Fragtprisen vises, før du betaler.`],
      ["Betaling", "VISA og Mastercard. Beløbet trækkes, når ordren sendes."],
      ["Fortrydelse", "14 dages fortrydelsesret på uåbnede varer."],
    ],
    contact: "Kontakt",
  },
  en: {
    title: "Mister Mellow ApS",
    description: `Mister Mellow ApS, CVR ${company.cvr}. Herbal products for smoking. Sold only to people aged 18 or over.`,
    sub: "We sell herbal products for smoking. We only deliver to addresses in Denmark.",
    categories: "Categories",
    age: "Age limit 18",
    ageText: "We do not sell to anyone under 18. Your age is checked with MitID before a purchase can be completed.",
    info: [
      ["Delivery", `Denmark only. Usually ${company.deliveryDays} business days. The shipping price is shown before you pay.`],
      ["Payment", "VISA and Mastercard. You are charged when the order ships."],
      ["Cancellation", "14-day right to cancel on unopened items."],
    ],
    contact: "Contact",
  },
}[lang];
---

<BaseLayout title={copy.title} description={copy.description}>
  <section class="hero">
    <div class="wrap">
      <h1 class="hero-title">{company.legalName}</h1>
      <p class="hero-sub">{copy.sub}</p>
      <div class="hero-actions">
        <a class="btn btn-navy" href={href(lang, "shop")}>{t.allProducts}</a>
        <a class="btn btn-ghost" href={href(lang, "faq")}>{t.faq}</a>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <SectionTitle title={copy.categories} />
      <div class="cat-list">
        {categories.map((c) => <a class="cat-tile cat-text" href={categoryHref(lang, c.id)}>{c.label[lang]} →</a>)}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="notice-box">
        <strong>{copy.age}.</strong> {copy.ageText}
      </div>
      <div class="info-grid">
        {copy.info.map(([h, p]) => (
          <div class="info-card">
            <h3>{h}</h3>
            <p>{p}</p>
          </div>
        ))}
        <div class="info-card">
          <h3>{copy.contact}</h3>
          <p><a href={`mailto:${company.serviceEmail}`}>{company.serviceEmail}</a><br /><a href={company.phoneHref}>{company.phone}</a></p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
