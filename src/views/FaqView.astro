---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { faq } from "../data/faq";
import { company } from "../data/company";
import { langFromUrl } from "../i18n";

const lang = langFromUrl(Astro.url);
const copy = {
  da: {
    description: "Svar om bestilling, levering, betaling, fortrydelse og alderskontrol hos Mister Mellow.",
    title: "Spørgsmål og svar",
    lead: `Finder du ikke svaret, så skriv til ${company.serviceEmail}.`,
  },
  en: {
    description: "Answers about ordering, delivery, payment, cancellation and age checks at Mister Mellow.",
    title: "Questions and answers",
    lead: `Can't find the answer? Email ${company.serviceEmail}.`,
  },
}[lang];
---

<BaseLayout title={`${copy.title} – Mister Mellow`} description={copy.description}>
  <section class="block page-top">
    <div class="wrap">
      <SectionTitle title={copy.title} />
      <p class="page-lead">{copy.lead}</p>
      {faq[lang].map((g) => (
        <div class="faq-group">
          <h2 class="faq-group-title">{g.title}</h2>
          <div class="faq">
            {g.items.map((f) => (
              <details>
                <summary>{f.q}<span class="faq-ico" aria-hidden="true">›</span></summary>
                {f.a.map((t) => <p>{t}</p>)}
                {f.list && <ul>{f.list.map((li) => <li>{li}</li>)}</ul>}
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
