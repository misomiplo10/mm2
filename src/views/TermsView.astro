---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import TermsDa from "./terms/TermsDa.astro";
import TermsEn from "./terms/TermsEn.astro";
import { langFromUrl, ui } from "../i18n";

const lang = langFromUrl(Astro.url);
const title = ui[lang].terms;
const description =
  lang === "en"
    ? "Terms and conditions for buying from Mister Mellow: prices, payment, delivery, returns and complaints."
    : "Handelsbetingelser for køb hos Mister Mellow: priser, betaling, levering, fortrydelsesret og klager.";
---

<BaseLayout title={`${title} – Mister Mellow`} description={description}>
  <section class="block page-top">
    <div class="wrap legal">
      <SectionTitle title={title} />
      {lang === "en" ? <TermsEn /> : <TermsDa />}
    </div>
  </section>
</BaseLayout>
