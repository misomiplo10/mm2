---
import PlainLayout from "../../layouts/PlainLayout.astro";
import ProductList from "../../components/ProductList.astro";
import { categoryHref, shopCategories, shopProducts } from "../../data/shop";
---

<PlainLayout title="Alle produkter – Mister Mellow ApS" description="Liste over urtebaserede rygeprodukter med vægt og pris. Salg kun til personer over 18 år.">
  <div class="box"><p><strong>Aldersgrænse 18 år.</strong> Det er forbudt at sælge urtebaserede rygeprodukter til personer under 18 år. Din alder kontrolleres med MitID, før et køb kan gennemføres.</p></div>
  <h1>Alle produkter</h1>
  <p class="muted">Urtebaserede rygeprodukter. Priser i danske kroner inkl. 25 % moms. Fragt vises i kurven, før du betaler.</p>
  <div class="tools">
    <label id="soeg">Søg efter produkt<input type="search" id="search" placeholder="Produktnavn" autocomplete="off" /></label>
    <nav aria-label="Kategorier" class="cats">
      {shopCategories.map((c) => <a class="btn" href={categoryHref(c)}>{c.label}</a>)}
    </nav>
  </div>
  <ProductList products={shopProducts} />
  <p id="no-hits" hidden>Ingen produkter matcher din søgning.</p>
</PlainLayout>

<style>
  .tools { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 8px 24px; margin: 20px 0 8px; }
  .tools label { flex: 1; min-width: 220px; margin: 0; }
  .cats { display: flex; flex-wrap: wrap; gap: 8px; }
</style>

<script>
  const input = document.getElementById("search") as HTMLInputElement;
  input.addEventListener("input", () => {
    const q = input.value.trim().toLowerCase();
    let hits = 0;
    document.querySelectorAll<HTMLElement>(".prow").forEach((row) => {
      const show = !q || row.dataset.name!.includes(q);
      row.hidden = !show;
      hits += Number(show);
    });
    document.getElementById("no-hits")!.hidden = hits > 0;
  });
</script>
