---
import BaseLayout from "../layouts/BaseLayout.astro";
import { kr, products } from "../data/products";
import { company } from "../data/company";

const VAT = 1.25;
const byName = (name: string) => products.find((p) => p.name === name)!;

// Fortjeneste ekskl. moms ved salg til vejl. udsalgspris
const marginRows = [
  { label: "Pre-roll · 1 g", product: byName("Daydream") },
  { label: "Sunday Cruise · 2 g", product: byName("Sunday Cruise") },
  { label: "Midnight Rider · 6 g", product: byName("Midnight Rider") },
].map(({ label, product }) => {
  const net = product.retail! / VAT;
  const profit = net - product.wholesale!;
  return { label, wholesale: product.wholesale!, retail: product.retail!, profit: Math.round(profit), pct: Math.round((profit / net) * 100) };
});

const priceRows = products
  .filter((p) => p.wholesale !== undefined)
  .map((p) => ({
    name: p.size ? `${p.name} · ${p.size}` : p.name,
    type: [p.format, p.strain].filter(Boolean).join(" · "),
    wholesale: p.wholesale!,
    retail: p.retail,
  }));

const subnav = [
  { href: "#opstart", label: "Opstartspakke" },
  { href: "#priser", label: "Priser" },
  { href: "#avance", label: "Avance" },
  { href: "#vilkaar", label: "Vilkår" },
  { href: "#kontakt", label: "Kontakt" },
];

const tips = [
  { ico: "⌂", title: "Placér displayet ved kassen", text: "Synlighed sælger. Displayet fanger blikket, mens kunden betaler." },
  { ico: "⚡", title: "Pre-rolls er impulskøb", text: "Lav pris og højeste avance (51 %). Hav altid fyldt op foran." },
  { ico: "◎", title: "Del på sociale medier", text: `Tag ${company.instagram}, så deler vi gerne din butik videre.` },
  { ico: "ID", title: "Sælg ansvarligt", text: "Kun til personer over 18 år. Spørg altid efter ID." },
];
---

<BaseLayout
  title="For forhandlere – Mister Mellow"
  description="Bliv forhandler af Mister Mellow. Opstartspakke inkl. display, høj avance, levering på 1–2 dage."
>
  <section class="page-hero">
    <img class="page-hero-sun" src="/img/logo-navy.png" alt="" aria-hidden="true" />
    <div class="wrap">
      <p class="eyebrow">For forhandlere</p>
      <h1 class="h2">Et display, der <em>sælger for dig.</em></h1>
      <p class="lead">Høj avance, hurtig omsætning og personlig levering. Sæt Mister Mellow ved kassen og lad sortimentet gøre arbejdet.</p>
      <div class="hero-actions">
        <a class="btn btn-orange" href="#kontakt">Bliv forhandler</a>
        <a class="btn btn-ghost" href={company.catalog} target="_blank" rel="noopener">Hent katalog 2026 (PDF)</a>
      </div>
    </div>
  </section>

  <nav class="subnav" aria-label="Forhandlersektioner">
    <div class="wrap">
      {subnav.map((s) => <a href={s.href}>{s.label}</a>)}
    </div>
  </nav>

  <section id="opstart">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Kom i gang</p>
        <h2 class="h2">Opstartspakke <em>til din butik.</em></h2>
      </div>
      <div class="starter reveal">
        <div>
          <div class="big-price">4.640 kr<small>EKSKL. MOMS</small></div>
          <p class="sub">5.800 kr inkl. moms</p>
          <ul class="ticks">
            <li>Sammensæt selv din pakke frit fra hele kollektionen.</li>
            <li>Mister Mellow-display medfølger.</li>
            <li>Vejledende udsalgspriser på alle produkter.</li>
          </ul>
          <a class="btn btn-orange" href="#kontakt">Bestil opstartspakke</a>
        </div>
        <img src="/img/display.jpg" alt="Mister Mellow display fyldt med pre-rolls og poser" loading="lazy" />
      </div>
    </div>
  </section>

  <section id="priser" style="padding-top: 0">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Produkter & priser</p>
        <h2 class="h2">Kollektionen <em>& priser.</em></h2>
        <p class="lead" style="margin-top: 16px">Indkøbspriser er ekskl. moms, vejl. udsalgspriser inkl. moms.</p>
      </div>
      <div class="table-card reveal">
        <table class="margin-table">
          <thead><tr><th>Produkt</th><th>Type</th><th>Indkøb ekskl. moms</th><th>Vejl. udsalg inkl. moms</th></tr></thead>
          <tbody>
            {priceRows.map((r) => (
              <tr><td>{r.name}</td><td>{r.type}</td><td>{kr(r.wholesale)}</td><td>{r.retail ? kr(r.retail) : "–"}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="avance" style="padding-top: 0">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Profit & markedsføring</p>
        <h2 class="h2">Sådan tjener <em>din butik penge.</em></h2>
      </div>
      <div class="table-card reveal">
        <table class="margin-table">
          <thead><tr><th>Produkt</th><th>Indkøb ekskl. moms</th><th>Vejl. udsalg inkl. moms</th><th>Fortjeneste pr. stk.*</th><th>Dækningsgrad</th></tr></thead>
          <tbody>
            {marginRows.map((r) => (
              <tr><td>{r.label}</td><td>{kr(r.wholesale)}</td><td>{kr(r.retail)}</td><td><b>{kr(r.profit)}</b></td><td class="pct">{r.pct} %</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="calc reveal">
        <div>
          <h3>Regneeksempel: opstartspakke</h3>
          <p>38 pre-rolls, 12 × Sunday Cruise, 4 × Midnight Rider og 2 lightere for i alt <b>4.640 kr</b> ekskl. moms.</p>
          <p>Solgt til vejl. udsalgspris giver det en omsætning på <b>10.934 kr</b> inkl. moms (8.747 kr ekskl. moms).</p>
        </div>
        <div class="calc-result">
          <span class="tag">BRUTTOFORTJENESTE</span>
          <b>≈ 4.100 kr</b>
          <span>ekskl. moms · +88 % på investeringen</span>
        </div>
      </div>
      <p class="fineprint">* Fortjeneste er beregnet ekskl. moms ved salg til vejledende udsalgspris. Beregningerne er vejledende; den faktiske fortjeneste afhænger af butikkens salgspris og salg. Lightere er ikke medregnet i omsætningen.</p>

      <div class="cards-4" style="margin-top: 40px">
        {tips.map((t) => (
          <div class="card tip reveal"><div class="ico">{t.ico}</div><h3>{t.title}</h3><p>{t.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section id="vilkaar" style="padding-top: 0">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Praktisk info</p>
        <h2 class="h2">Vilkår <em>& levering.</em></h2>
      </div>
      <div class="cards-2">
        <div class="card reveal">
          <h3>Bestilling & levering</h3>
          <table class="terms">
            <tr><td>Minimumsordre</td><td>4.640 kr ekskl. moms</td></tr>
            <tr><td>Leveringstid</td><td>1–2 dage fra bestilling</td></tr>
            <tr><td>Levering</td><td>Personlig levering</td></tr>
            <tr><td>Betaling</td><td>Faktura<small>Første ordre betales ved levering<br />Herefter netto 7 dage</small></td></tr>
          </table>
        </div>
        <div class="card reveal">
          <h3>Genbestilling</h3>
          <p>Hold øje med lageret i displayet, og genbestil i god tid – så står hylderne aldrig tomme, når kunderne kommer igen.</p>
          <ol class="steps">
            <li>Tæl op, hvad der mangler i displayet.</li>
            <li>Send antal pr. produkt til {company.email} eller ring.</li>
            <li>Vi bekræfter ordren og sender faktura.</li>
          </ol>
        </div>
        <div class="card lavender reveal">
          <h3>Opbevaring</h3>
          <p>Opbevar produkterne køligt, tørt og mørkt i lukket emballage. THC-A omdannes gradvist ved varme og lys, så undgå vinduer og varmekilder. Sælg efter først-ind-først-ud.</p>
        </div>
        <div class="card peach reveal">
          <h3>Ansvarligt salg</h3>
          <p>Salg kun til personer over 18 år – spørg altid efter legitimation. Opbevares utilgængeligt for børn.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="kontakt" style="padding-top: 0">
    <div class="wrap">
      <div class="contact reveal">
        <div>
          <h2 class="h2">Kontakt <em>os.</em></h2>
          <p>Vi hjælper gerne med at sammensætte den rette pakke til din butik. Skriv eller ring – vi svarer hurtigt.</p>
        </div>
        <div class="contact-lines">
          <a href={`mailto:${company.email}?subject=Forhandlerforesp%C3%B8rgsel`}>{company.email} <span>Mail</span></a>
          <a href={company.phoneHref}>{company.phone} <span>Ring</span></a>
          <a href={company.instagramUrl} target="_blank" rel="noopener">{company.instagram} <span>Instagram</span></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
