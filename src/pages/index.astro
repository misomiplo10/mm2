---
import BaseLayout from "../layouts/BaseLayout.astro";
import SunPalette from "../components/SunPalette.astro";
import ProductCard from "../components/ProductCard.astro";
import ProductVisual from "../components/ProductVisual.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { categories, products } from "../data/products";
import { company } from "../data/company";

const featured = products.filter((p) => p.featured);

const promos = [
  { eyebrow: "Lab-testet", big: "25,12 %", small: "THC-A · Amnesia Haze", href: "/lab-rapporter", cta: "Se rapporterne", tone: "navy" },
  { eyebrow: "Pre-rolls", big: "1 g", small: "Daydream & Sunrise · håndrullet", href: "/shop?kategori=preroll", cta: "Se pre-rolls", tone: "pink" },
  { eyebrow: "For butikker", big: "51 %", small: "dækningsgrad på pre-rolls", href: "/forhandler", cta: "Bliv forhandler", tone: "orange" },
];
---

<BaseLayout
  title="Mister Mellow – Not your average hash"
  description="Mister Mellow er et dansk brand med medical grade Cali-flower og hash med THC-A. Lab-testet, høj styrke, gode vibes. Kun 18+."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="kicker">Mister Mellow · Cali flower & hash</p>
        <h1 class="hero-title">Not your <span class="o">average</span> hash.</h1>
        <p class="hero-sub">Medical grade THC-A – lab-testet, høj styrke, gode vibes.</p>
        <div class="hero-actions">
          <a class="btn btn-navy" href="/shop">Shop nu</a>
          <a class="btn btn-ghost" href="/find-os">Find os</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="hero-ring"></div>
        <img class="hero-bud" src="/img/bud-hero.webp" alt="" width="490" height="811" />
        <div class="float float-l"><img class="hero-tube" src="/img/tube-daydream.webp" alt="" /></div>
        <div class="float float-r"><img class="hero-tube" src="/img/tube-sunrise.webp" alt="" /></div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <SectionTitle title="Find din mellow" link={{ href: "/shop", label: "Se alle" }} mascot="lounging" />
      <div class="rail cat-rail">
        {categories.map((c) => (
          <a class="cat-tile" href={`/shop?kategori=${c.id}`}>
            <div class={`cat-media bg-${c.tint}`}><ProductVisual visual={c.visual} /></div>
            <span>{c.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <SectionTitle title="Det gode stuff" mascot="peeking" />
      <div class="promos">
        {promos.map((p) => (
          <a class={`promo promo-${p.tone}`} href={p.href}>
            <span class="promo-eyebrow">{p.eyebrow}</span>
            <span class="promo-big">{p.big}</span>
            <span class="promo-small">{p.small}</span>
            <span class="promo-cta">{p.cta} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <SectionTitle title="Mister Mellows favoritter" link={{ href: "/shop", label: "Se alle" }} />
      <div class="rail-wrap">
        <div class="rail product-rail" id="picks">
          {featured.map((p) => <ProductCard product={p} />)}
        </div>
        <div class="rail-nav">
          <button class="rail-btn" data-rail="picks" data-dir="-1" aria-label="Forrige">‹</button>
          <button class="rail-btn" data-rail="picks" data-dir="1" aria-label="Næste">›</button>
        </div>
      </div>
    </div>
  </section>

  <section class="story">
    <div class="wrap story-inner">
      <div class="story-copy">
        <p class="kicker">Mød Mister Mellow</p>
        <h2 class="story-title">Lidt highness i hver pakke.</h2>
        <p>Mister Mellow er et dansk brand med én mission: medical grade Cali-flower og hash – Fresh Frozen og Dry Sift – med THC-A.</p>
        <div class="hero-actions">
          <a class="btn btn-orange" href="/om-os">Læs mere om os</a>
          <a class="btn btn-ghost-light" href="/shop">Gå til shoppen</a>
        </div>
      </div>
      <SunPalette />
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap cta-inner">
      <div>
        <p class="kicker">Mister Mellow på Instagram</p>
        <h2>Få nye drops først.</h2>
        <p>Følg med for nye sorter, butikker og events – og tag os, når du finder din mellow.</p>
      </div>
      <a class="btn btn-navy btn-lg" href={company.instagramUrl} target="_blank" rel="noopener">Følg {company.instagram}</a>
    </div>
  </section>
</BaseLayout>
